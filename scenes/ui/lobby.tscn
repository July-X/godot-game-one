[gd_scene format=3 uid="uid://lobby_scene"]

[ext_resource type="Script" path="res://scripts/ui/lobby.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/ui/entry_backdrop.tscn" id="2"]
[ext_resource type="Theme" path="res://scenes/ui/entry_theme.tres" id="3"]
[ext_resource type="Script" path="res://scripts/ui/entry_card.gd" id="4"]

[node name="Lobby" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
theme = ExtResource("3")
script = ExtResource("1")

[node name="Space" parent="." instance=ExtResource("2")]

[node name="VBox" type="VBoxContainer" parent="."]
theme_override_constants/separation = 14
mouse_filter = 2

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "双人联机"

[node name="Subtitle" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = ""
visible = false
theme_override_colors/font_color = Color(0.63, 0.73, 0.83, 1)
autowrap_mode = 3

[node name="PanelModeSelect" type="GridContainer" parent="VBox"]
layout_mode = 2
columns = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="BtnBeHost" type="Button" parent="VBox/PanelModeSelect"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 92)
theme_type_variation = &"LaunchCard"
text = "创建房间"
script = ExtResource("4")
detail = "等搭档加入后开始"

[node name="BtnBeClient" type="Button" parent="VBox/PanelModeSelect"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 92)
text = "加入附近房间"
script = ExtResource("4")
detail = "搜索并选择搭档的房间"

[node name="PanelHost" type="VBoxContainer" parent="VBox"]
layout_mode = 2
visible = false
theme_override_constants/separation = 10

[node name="RoomInfo" type="HBoxContainer" parent="VBox/PanelHost"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="RoomType" type="Label" parent="VBox/PanelHost/RoomInfo"]
layout_mode = 2
theme_override_font_sizes/font_size = 21
text = "普通合作 / 裂隙航道"
size_flags_horizontal = 3
autowrap_mode = 3

[node name="Occupancy" type="Label" parent="VBox/PanelHost/RoomInfo"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "1 / 2"
theme_override_colors/font_color = Color(0.52, 0.85, 0.88, 1)

[node name="LblHostStatus" type="Label" parent="VBox/PanelHost"]
layout_mode = 2
theme_override_font_sizes/font_size = 19
text = "等待搭档加入"
autowrap_mode = 3

[node name="HostDetail" type="Label" parent="VBox/PanelHost"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = ""
theme_override_colors/font_color = Color(0.63, 0.73, 0.83, 1)
autowrap_mode = 3

[node name="BtnStart" type="Button" parent="VBox/PanelHost"]
layout_mode = 2
custom_minimum_size = Vector2(0, 54)
text = "开始普通合作"
visible = false
disabled = true

[node name="RiftRule" type="OptionButton" parent="VBox/PanelHost"]
layout_mode = 2
custom_minimum_size = Vector2(0, 54)
visible = false
clip_text = true

[node name="BtnRiftRoute" type="Button" parent="VBox/PanelHost"]
layout_mode = 2
custom_minimum_size = Vector2(0, 54)
text = "开始裂隙航道"
visible = false
disabled = true

[node name="RetryHost" type="Button" parent="VBox/PanelHost"]
layout_mode = 2
custom_minimum_size = Vector2(0, 54)
text = "重新创建房间"
visible = false

[node name="PanelJoin" type="VBoxContainer" parent="VBox"]
layout_mode = 2
visible = false
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="LblScanHint" type="Label" parent="VBox/PanelJoin"]
layout_mode = 2
