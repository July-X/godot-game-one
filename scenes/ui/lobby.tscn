[node name="LblJoinStatus" type="Label" parent="VBox/PanelJoin"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = ""
theme_override_colors/font_color = Color(0.63, 0.73, 0.83, 1)
autowrap_mode = 3

[node name="HostListScroll" type="ScrollContainer" parent="VBox/PanelJoin"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0
