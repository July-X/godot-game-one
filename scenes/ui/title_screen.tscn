[gd_scene format=3]

[ext_resource type="Texture2D" path="res://assets/sprites/ui/logo.png" id="1"]
[ext_resource type="Script" path="res://scripts/ui/title_screen.gd" id="2"]
[ext_resource type="PackedScene" path="res://scenes/ui/entry_backdrop.tscn" id="3"]
[ext_resource type="Theme" path="res://scenes/ui/entry_theme.tres" id="4"]
[ext_resource type="Script" path="res://scripts/ui/entry_card.gd" id="5"]

[sub_resource type="Shader" id="LogoContrast"]
code = "shader_type canvas_item;
void fragment() {
	// The existing 512 px artwork cuts through the last word.
	// Extend its canvas and reuse the full pixel L already in BULLET.
	float x = UV.x * 576.0;
	float source_x = x;
	if (x >= 512.0) {
		source_x = 18.0;
		if (UV.y >= 0.52 && UV.y < 0.87) {
			if (x < 518.0) {
				source_x = x - 276.0;
			} else if (x >= 524.0 && x < 566.0) {
				source_x = x - 324.0;
			}
		}
	}
	vec4 ink = texture(TEXTURE, vec2(source_x / 512.0, UV.y));
	COLOR = vec4(min(ink.rgb * 2.7, vec3(1.0)), ink.a);
}"

[sub_resource type="ShaderMaterial" id="LogoMaterial"]
shader = SubResource("LogoContrast")

[node name="TitleScreen" type="CanvasLayer"]
script = ExtResource("2")

[node name="Space" parent="." instance=ExtResource("3")]

